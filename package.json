{
  "name": "dsh-riskproof",
  "version": "0.3.0",
  "description": "See what your AI agent protected: session security receipts, visible data provenance, task boundaries, and tool identity checks for DeepSeek Harness.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./client": {
      "types": "./dist/client/panel.d.ts",
      "default": "./dist/client.js"
    }
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "docs",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "ai-agent",
    "agent-security",
    "provenance",
    "information-flow-control",
    "tool-security",
    "taint-tracking",
    "execution-security",
    "policy-engine"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onlyqzq/dsh-riskproof.git"
  },
  "bugs": {
    "url": "https://github.com/onlyqzq/dsh-riskproof/issues"
  },
  "homepage": "https://github.com/onlyqzq/dsh-riskproof#readme",
  "author": "RiskProof Contributors",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-session-controller"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc && node scripts/build-client.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "lint": "npm run typecheck && npm run typecheck:test",
    "check:marketplace": "node scripts/check-marketplace-readiness.mjs",
    "verify": "npm run lint && npm run check:marketplace && npm run build && npm test",
    "pack:smoke": "npm run build && npm pack --dry-run",
    "demo": "npm run build && node demo/run-attack-chain.mjs",
    "prepare": "npm run build",
    "prepublishOnly": "npm run verify",
    "check:dsh": "node scripts/check-dsh-install.mjs",
    "check:web": "node scripts/check-web.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.7 || ^0.1.1-rc.1 || ^0.1.2-rc.1",
    "@deepseek-ai/dsh-commands": "^0.1.0-rc.7 || ^0.1.1-rc.1 || ^0.1.2-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.7 || ^0.1.1-rc.1 || ^0.1.2-rc.1",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.2-rc.1",
    "@deepseek-ai/dsh-commands": "0.1.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.2-rc.1",
    "@deepseek-ai/dsh-scope": "0.1.2-rc.1",
    "@deepseek-ai/dsh-session": "0.1.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.2-rc.1",
    "@deepseek-ai/schemastery": "3.18.2",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "4.1.11",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.0",
    "typescript": "^5.8.0",
    "vitest": "4.1.11"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-commands": {
      "optional": true
    }
  }
}
